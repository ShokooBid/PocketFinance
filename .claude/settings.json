{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run format:check *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm run test:integration:local *)",
      "Bash(npm run db:validate *)",
      "Bash(npm run db:status *)",
      "Bash(npm run openapi *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./local-data/**)",
      "Read(./backups/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands"
          }
        ]
      }
    ]
  }
}
